#: includes/Plugin.php:82
msgid "Settings"
msgstr "Opções"

#: includes/Providers/Facebook.php:138
msgid "Facebook video"
msgstr "Vídeo do Facebook"

#: includes/Providers/Facebook.php:141
msgid "Facebook post"
msgstr "Publicação do Facebook"

#: includes/Providers/Instagram.php:118
msgid "Instagram reel"
msgstr "Reel do Instagram"

#: includes/Providers/Instagram.php:121
msgid "Instagram post"
msgstr "Publicação do Instagram"

#. translators: %s: The provider name, for example Facebook.
#: includes/Providers/Provider.php:142
#, php-format
msgid "This %s content loads after you accept cookies."
msgstr "Este conteúdo do %s carrega depois de aceitar os cookies."

#. translators: %s: The provider name, for example Facebook.
#: includes/Providers/Provider.php:150
#, php-format
msgid "View on %s"
msgstr "Ver no %s"

#: includes/Settings.php:107
msgid "Embeds"
msgstr "Incorporações"

#: includes/Settings.php:114
msgid "Consent category"
msgstr "Categoria de consentimento"

#: includes/Settings.php:123
msgid "Require consent"
msgstr "Exigir consentimento"

#: includes/Settings.php:139
msgid "Facebook and Instagram embeds set third-party cookies. When a consent tool is active, they load only after the visitor accepts the cookie category below."
msgstr "As incorporações do Facebook e do Instagram definem cookies de terceiros. Com uma ferramenta de consentimento activa, carregam apenas depois de o visitante aceitar a categoria de cookies abaixo."

#: includes/Settings.php:160
msgid "The slug of the cookie category in your consent tool, for example \"advertisement\" or \"functional\" in CookieYes. Use the category in which the consent tool lists the Facebook and Instagram cookies."
msgstr "O slug da categoria de cookies na ferramenta de consentimento, por exemplo \"advertisement\" ou \"functional\" no CookieYes. Use a categoria em que a ferramenta de consentimento lista os cookies do Facebook e do Instagram."

#: includes/Settings.php:176
msgid "Show only a notice and a link when no consent tool is active"
msgstr "Mostrar apenas um aviso e uma ligação quando nenhuma ferramenta de consentimento está activa"

#: includes/Settings.php:181
msgid "When this is off and no consent tool is active, embeds load at once."
msgstr "Com esta opção desactivada e sem ferramenta de consentimento activa, as incorporações carregam de imediato."
